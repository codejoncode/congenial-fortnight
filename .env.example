# Environment Variables Example

# Required API keys for fundamental data sources
# Replace the placeholder values with your actual keys

# Alpha Vantage
AV_API_KEY=

# Finnhub
FINNHUB_API_KEY=

# Financial Modeling Prep
FMP_API_KEY=

# API Ninja (optional)
API_NINJA_KEY=

# Optional additional sources
# IEX Cloud
IEX_API_KEY=

# Twelve Data
TWELVE_DATA_KEY=

# Other configuration
DATA_DIR=data/

# ── Email alerts (optional — free with Gmail) ─────────────────────────────────
# Step-by-step setup:
#   1. Go to: myaccount.google.com → Security → 2-Step Verification (enable it)
#   2. Then go to: myaccount.google.com → Security → App Passwords
#   3. Select "Mail" + "Windows Computer" → click Generate
#   4. Copy the 16-character password shown (no spaces)
#   5. Paste below — alerts will fire automatically after each signal
#
ALERT_EMAIL_HOST_USER=your@gmail.com
ALERT_EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
ALERT_EMAIL_TO=your@gmail.com

# Minimum signal probability to trigger an email alert (default: 0.60 = 60%)
SIGNAL_NOTIFY_THRESHOLD=0.60
